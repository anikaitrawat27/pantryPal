# Postgres connection string. In Vercel, adding Neon from the Storage tab sets this.
# Leave unset locally to use PGlite in .data/pglite.
DATABASE_URL=

# Public URL used in the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=

# Enables the kitchen helper chatbot. Get a key at https://platform.claude.com.
ANTHROPIC_API_KEY=
